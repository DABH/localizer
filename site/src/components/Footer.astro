---
// Starlight's footer, plus the site links and the copyright notice.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<nav class="legal" aria-label="More">
	<a href="/pricing/">Pricing</a>
	<a href="/terms/">Terms</a>
	<a href="/privacy/">Privacy</a>
	<a href="/sla/">SLA</a>
	<a href="https://github.com/DABH/localizer/releases">Changelog</a>
	<a href="mailto:saluton@locale.dev">Contact</a>
</nav>
<p class="copyright">© 2026 Snizyx Software LLC</p>

<style>
	.legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		margin-top: 2rem;
		font-size: var(--sl-text-sm);
	}
	.legal a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.legal a:hover {
		color: var(--sl-color-white);
	}
	.copyright {
		margin-top: 1rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		text-align: center;
	}
</style>
